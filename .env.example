# AfriClimate Analytics Lake - Environment Variables Template
# Copy this file to .env and fill in your actual values

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=af-south-1
AWS_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/MetabaseAthenaRole

# S3 Configuration
S3_BUCKET_NAME=africlimate-analytics-lake
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/
S3_ATHENA_RESULTS_PREFIX=athena-results/

# Glue Configuration
GLUE_DATABASE_NAME=africlimate_climate_db
GLUE_CRAWLER_NAME=chirps-crawler

# Athena Configuration
ATHENA_OUTPUT_LOCATION=s3://aws-athena-query-results-701742813629-af-south-1/
ATHENA_WORKGROUP=primary

# Metabase Configuration
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=your_metabase_admin_email
METABASE_ADMIN_PASSWORD=your_metabase_admin_password

# Lambda Configuration
LAMBDA_TIMEOUT=300
LAMBDA_MEMORY_SIZE=512
LAMBDA_RUNTIME=python3.9

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Processing Configuration
CHIRPS_DATA_SOURCE=https://deAfrica.org/
CHIRPS_VERSION=v2.0
DATA_RETENTION_DAYS=365

# Security Configuration
ENABLE_ENCRYPTION=true
KMS_KEY_ID=alias/africlimate-analytics-key

# Monitoring Configuration
ENABLE_CLOUDWATCH_METRICS=true
ALERT_EMAIL=admin@africlimate.local

# Development Configuration
DEBUG=false
TEST_MODE=false
